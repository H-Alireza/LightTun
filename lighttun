write_tuning() {
  cat > /etc/sysctl.d/99-lighttun.conf <<'EOF'
# LightTun server tuning
net.ipv4.ip_forward = 1
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
# TCP: BBR + fq pacing
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 131072
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_max_tw_buckets = 1440000
net.ipv4.tcp_max_syn_backlog = 32768
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.ip_local_port_range = 10000 65535
# buffers: high ceilings for fast long-distance links (the kernel only grows a socket that needs it);
# defaults stay at 1 MB because every socket, UDP ones included, starts at the default
net.core.rmem_max = 268435456
net.core.wmem_max = 268435456
net.core.rmem_default = 1048576
net.core.wmem_default = 1048576
net.core.optmem_max = 65536
net.ipv4.tcp_rmem = 4096 131072 268435456
net.ipv4.tcp_wmem = 4096 65536 268435456
net.ipv4.udp_rmem_min = 16384
net.ipv4.udp_wmem_min = 16384
net.core.netdev_max_backlog = 250000
net.core.netdev_budget = 600
net.core.somaxconn = 65536
# conntrack: big table, game UDP sessions survive pauses
net.netfilter.nf_conntrack_max = 1048576
net.netfilter.nf_conntrack_tcp_timeout_established = 7200
net.netfilter.nf_conntrack_udp_timeout = 60
net.netfilter.nf_conntrack_udp_timeout_stream = 300
# system
fs.file-max = 2097152
fs.nr_open = 2097152
vm.swappiness = 10
EOF
  # TCP memory for the whole machine, in pages: pressure at 1/8 of RAM, hard limit at 1/5. The kernel's default
  # (under 1/11 of RAM) is reached by a relay with thousands of sockets, which then shrinks every buffer.
  local pg; pg=$(( $(awk '/^MemTotal/{print $2}' /proc/meminfo) * 1024 / $(getconf PAGESIZE) ))
  echo "net.ipv4.tcp_mem = $(( pg / 12 )) $(( pg / 8 )) $(( pg / 5 ))" >> /etc/sysctl.d/99-lighttun.conf
  printf '%s\n' tcp_bbr sch_fq sch_cake nf_conntrack ip_gre ipip fou vxlan wireguard > /etc/modules-load.d/lighttun.conf
  echo "options nf_conntrack hashsize=262144" > /etc/modprobe.d/lighttun.conf
  printf '* soft nofile 1048576\n* hard nofile 1048576\nroot soft nofile 1048576\nroot hard nofile 1048576\n' > /etc/security/limits.d/lighttun.conf
  mkdir -p /etc/systemd/system.conf.d
  printf '[Manager]\nDefaultLimitNOFILE=1048576\n' > /etc/systemd/system.conf.d/lighttun.conf
}

cmd_optimize() {
  need_root
  write_tuning
  modprobe sch_cake 2>/dev/null || apt-get -o DPkg::Lock::Timeout=600 install -y -qq "linux-modules-extra-$(uname -r)" >/dev/null 2>&1
  systemctl enable --now irqbalance >/dev/null 2>&1
  cmd__boot
  ok "server tuned: BBR, fq, big buffers, conntrack, file limits, NIC rings ($(sysctl -n net.ipv4.tcp_congestion_control))"
}

cmd_setup() {
  need_root
  mkdir -p "$TDIR" "$STATE" "$OPT"
  [[ -f $GCONF ]] || { load_global; save_global; }
  write_units
  cmd_optimize
  systemctl enable lighttun-base >/dev/null 2>&1
  systemctl enable --now lighttun-monitor >/dev/null 2>&1
  ok "LightTun $VERSION ready - run: lighttun"
}

cmd_uninstall() {
  need_root
  local n a
  read -rp "Remove LightTun and stop all tunnels? [y/N]: " a; [[ $a =~ ^[yY] ]] || return
  for n in $(tunnel_names); do load_tunnel "$n"; stop_tunnel; done
  systemctl disable --now lighttun-monitor lighttun-base >/dev/null 2>&1
  load_global; [[ -n $QOS_WAN ]] && tc qdisc del dev "$QOS_WAN" root 2>/dev/null
  rm -f "$UNITDIR"/lighttun-base.service "$UNITDIR"/lighttun@.service "$UNITDIR"/lighttun-proc@.service "$UNITDIR"/lighttun-ka@.service \
        "$UNITDIR"/lighttun-monitor.service
  rm -f /etc/sysctl.d/99-lighttun.conf /etc/modules-load.d/lighttun.conf /etc/modprobe.d/lighttun.conf \
        /etc/security/limits.d/lighttun.conf /etc/systemd/system.conf.d/lighttun.conf
  systemctl daemon-reload
  rm -rf -- "$OPT" "$STATE"
  read -rp "Also delete tunnel configs in $ETC? [y/N]: " a; [[ $a =~ ^[yY] ]] && rm -rf -- "$ETC"
  rm -f "$BIN"
  ok "LightTun removed"
}

# ---------------------------------------------------------------- benchmark

# test types: kernel tunnels (incl. WireGuard), all opened by the serve (abroad) side; FEC over plain UDP /
# fake TCP / ICMP; fecrev = FEC over plain UDP opened by the serve side; port tunnels opened by the serve side too:
# rathole, BackPack over tcp (bp), tcp+mux (bpmux) and kcp = UDP with FEC (bpkcp), ltcar; vxmux = vxlan over 16 flows
BENCH_TYPES=(gre ipip vxlan vxmux fou wg fec fecraw fecrev fecicmp rathole bp bpmux bpkcp ltcar)
BENCH_PIDS=()
BENCH_UP=()
BENCH_RT_PORT=15201

bench_def() {   # index type role(a|b) peer_public
  local i=$1 t=$2 role=$3
  reset_tunnel
  NAME="ltb_$t" TYPE=$t LOCAL_IP=$(src_ip_for "$4") REMOTE_IP=$4 PRIORITY=normal TTL=64
  local net="10.250.$(( i + 1 ))"
  case $t in
    gre)   KEY=7001 ;;
    fou)   KEY=7002 PORT=15555 ;;
    vxlan) VNI=7003 PORT=14789 ;;
    vxmux) TYPE=vxlan VNI=7004 PORT=14800 FLOWS=16 ;;
    wg)    SECRET=lighttun-bench PORT=15820 ;;
    fec*)
      TYPE=fec SECRET=lighttun-bench FEC=10:5 FEC_TIMEOUT=2 FEC_MODE=1 PORT=$(( 16000 + i * 10 )) RAW=no
      [[ $t == fecraw ]] && RAW=yes
      [[ $t == fecicmp ]] && RAW=icmp
      local srv=b; [[ $t == fecrev ]] && srv=a
      if [[ $role == "$srv" ]]; then ROLE=server ADDR=$net.1/24 PEER=$net.2; else ROLE=client ADDR=$net.2/24 PEER=$net.1; fi ;;
    rathole|bp*|ltcar)
      # each port tunnel carries its own iperf port and, one above it, a UDP echo port for RTT
      BENCH_RT_PORT=$(( 15100 + i * 2 ))
      SECRET=lighttun-bench PORT=$(( 15300 + i )) FWD_TCP=$BENCH_RT_PORT FWD_UDP="$BENCH_RT_PORT $(( BENCH_RT_PORT + 1 ))"
      case $t in bp) TYPE=backpack CARRIER=tcp ;; bpmux) TYPE=backpack CARRIER=tcpmux ;; bpkcp) TYPE=backpack CARRIER=kcp ;; esac
      if [[ $role == b ]]; then ROLE=client; else ROLE=server; fi ;;
  esac
  if is_kernel; then
    if [[ $role == a ]]; then ADDR=$net.1/30 PEER=$net.2 OPENER=peer; else ADDR=$net.2/30 PEER=$net.1 OPENER=me; fi
  fi
  tunnel_defaults
}

udp2raw_clear() {   # remove udp2raw's leftover INPUT rules for one port (it does not always clean up)
  local r c
  iptables -w -S INPUT 2>/dev/null | grep -- "-j udp2raw" | grep -E -- "--(sport|dport) $1( |$)" | while read -r r; do
    c=${r##*-j }; ipt ${r/-A /-D }; ipt -F "$c" 2>/dev/null; ipt -X "$c" 2>/dev/null
  done
}

bench_cleanup() {
  local i
  [[ ${#BENCH_PIDS[@]} -gt 0 ]] && kill "${BENCH_PIDS[@]}" 2>/dev/null
  pkill -f -- "--tun-dev ltb_" 2>/dev/null; pkill -f -- "-k lighttun-bench" 2>/dev/null; pkill -f -- "rathole-ltb_" 2>/dev/null
  pkill -f -- "backpack-ltb_" 2>/dev/null; pkill -f -- "lighttun-udp-echo" 2>/dev/null; pkill -f -- "-name ltb_" 2>/dev/null
  pkill -f -- "lighttun-flow-opener" 2>/dev/null
  sleep 0.5
  for i in "${!BENCH_TYPES[@]}"; do
    bench_def "$i" "${BENCH_TYPES[$i]}" a "$BENCH_PEER"
    fw_clear "$NAME"; ip link del "$NAME" 2>/dev/null
    [[ $TYPE == fec ]] && udp2raw_clear "$PORT"
  done
  ip fou del port 15555 2>/dev/null
  rm -f "$STATE"/rathole-ltb_*.toml "$STATE"/backpack-ltb_*   # BackPack leaves a .metrics.json too
  return 0
}

bench_setup() {   # role peer
  local i t e k
  BENCH_PEER=$2
  bench_cleanup >/dev/null 2>&1   # leftovers from an interrupted run
  trap 'bench_cleanup; exit' INT TERM HUP
  trap bench_cleanup EXIT
  for i in "${!BENCH_TYPES[@]}"; do
    t=${BENCH_TYPES[$i]}
    [[ -z $BENCH_ONLY || " $BENCH_ONLY " == *" $t "* ]] || continue
    case $t in
      fec*) [[ -x $OPT/tinyvpn ]] || { warn "skip $t: run 'lighttun install fec'"; continue; }
            [[ $t != fec && ! -x $OPT/udp2raw ]] && continue ;;
      rathole) [[ -x $OPT/rathole ]] || { warn "skip rathole: run 'lighttun install rathole'"; continue; } ;;
      bp*) [[ -n $(bp_bin) ]] || { warn "skip $t: run 'lighttun install backpack'"; continue; } ;;
      ltcar) [[ -x $OPT/ltcar ]] || { warn "skip ltcar: run 'lighttun install ltcar'"; continue; } ;;
      wg) command -v wg >/dev/null || { warn "skip wg: apt install wireguard-tools"; continue; } ;;
    esac
    bench_def "$i" "$t" "$1" "$2"
    case $TYPE in
      fec) ( fec_run ) >/dev/null 2>&1 & BENCH_PIDS+=($!) ;;
      rathole) "$OPT/rathole" "$(rathole_conf)" >/dev/null 2>&1 & BENCH_PIDS+=($!) ;;
      backpack) "$(bp_bin)" -c "$(backpack_conf)" >/dev/null 2>&1 & BENCH_PIDS+=($!) ;;
      ltcar) ( ltcar_exec exec ) >/dev/null 2>&1 & BENCH_PIDS+=($!) ;;
      *) link_up 2>/dev/null || { warn "skip $t: could not create (another tunnel of this kind to this server?)"; continue; } ;;
    esac
    BENCH_UP+=("$i:$t")
  done
  for e in "${BENCH_UP[@]}"; do
    i=${e%%:*}; bench_def "$i" "${e#*:}" "$1" "$2"
    if [[ $TYPE == fec ]]; then
      for k in $(seq 20); do ip link show "$NAME" &>/dev/null && break; sleep 0.25; done
      ip link set "$NAME" mtu "$MTU" up 2>/dev/null
    fi
    fw_apply
    # the serve (abroad) side opens kernel tunnels and keeps them open (wg: persistent-keepalive)
    [[ $OPENER == me && $TYPE != wg ]] && { ping -n -q -i 1 -W 1 "$PEER" >/dev/null 2>&1 & BENCH_PIDS+=($!); }
    [[ $OPENER == me && $TYPE == vxlan ]] && (( FLOWS > 1 )) && { flow_opener & BENCH_PIDS+=($!); }
    if [[ $1 == b ]]; then
      if is_port_tun; then
        iperf3 -s -B 127.0.0.1 -p "$BENCH_RT_PORT" >/dev/null 2>&1 & BENCH_PIDS+=($!)
        udp_echo $(( BENCH_RT_PORT + 1 )) & BENCH_PIDS+=($!)
      else iperf3 -s -B "${ADDR%/*}" >/dev/null 2>&1 & BENCH_PIDS+=($!); fi
    fi
  done
  ok "test tunnels: ${BENCH_UP[*]#*:}"
}

udp_echo() {   # port: answers every datagram on 127.0.0.1 (RTT through a port tunnel)
  exec python3 -c 'import socket,sys  # lighttun-udp-echo
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.bind(("127.0.0.1",int(sys.argv[1])))
while True:
  d,a=s.recvfrom(2048); s.sendto(d,a)' "$1"
}

udp_ping() {   # host port count interval -> "loss avg mdev", like ping_stats but through a forwarded UDP port
  python3 -c 'import socket,sys,time,statistics
h,p,n,iv=sys.argv[1],int(sys.argv[2]),int(sys.argv[3]),float(sys.argv[4])
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(1); rt=[]
for i in range(n):
  t=time.time(); m=str(i).encode(); s.sendto(m,(h,p))
  try:
    while s.recvfrom(64)[0]!=m: pass
    rt.append((time.time()-t)*1000)
  except socket.timeout: pass
  time.sleep(max(0,iv-(time.time()-t)))
print("%.0f %.3f %.3f"%(100*(n-len(rt))/n,statistics.mean(rt),statistics.pstdev(rt)) if rt else "100 - -")' "$@"
}

cpu_pct() { awk -v b1="$1" -v t1="$2" -v b2="$3" -v t2="$4" 'BEGIN{d=t2-t1; printf "%.1f", (d > 0 ? (b2-b1)*100/d : 0)}'; }   # snap1 snap2
cpu_snap() { awk '/^cpu /{b=$2+$3+$4+$7+$8+$9; print b, b+$5+$6}' /proc/stat; }
jget() { python3 -c "import json,sys
try:
  d=json.load(open(sys.argv[1])); print(round(eval(sys.argv[2]),2))
except Exception: print('-')" "$1" "$2"; }

cmd_bench() {
  need_root
  command -v iperf3 >/dev/null || die "iperf3 missing: apt install iperf3"
  local mode=$1 peer=$2; shift 2; BENCH_ONLY="$*"
  is_ip "$peer" || die "usage: lighttun bench serve <other-server-ip>   (on the abroad server, first)
       lighttun bench run <other-server-ip>     (on the Iran server)"
  case $mode in
    serve)
      bench_setup b "$peer"
      echo; ok "Ready. Now run on the other server:  ${W}lighttun bench run $(src_ip_for "$peer")${N}"
      info "Waiting (Ctrl+C to stop, auto-stop in 15 min)..."
      sleep 900 & wait $! ;;   # background + wait so Ctrl+C / kill cleans up at once
    run)
      SECONDS=0
      bench_setup a "$peer"
      local tmp; tmp=$(mktemp -d); local res=$tmp/results
      local bl bavg; read -r bl bavg _ < <(ping_stats "$peer" 30 0.05)
      info "baseline ping to $peer (no tunnel): ${bavg} ms, loss ${bl}%"
      local e i t k ip ipf loss rtt jit ujit uloss lrtt up dn cpu cpd c1 c2 c3 pm sz
      for e in "${BENCH_UP[@]}"; do
        i=${e%%:*} t=${e#*:}; bench_def "$i" "$t" a "$peer"; pm=-
        printf '%s' "${C}[*]${N} $t: "
        if is_port_tun; then
          ip=127.0.0.1 ipf=(-p "$BENCH_RT_PORT")
          for k in $(seq 15); do timeout 6 iperf3 -c $ip "${ipf[@]}" -t 1 --connect-timeout 2000 >/dev/null 2>&1 && break; sleep 1; done
          (( k < 15 )) || { echo "no connection"; echo "$t fail" >> "$res"; continue; }
          read -r loss rtt jit < <(udp_ping 127.0.0.1 $(( BENCH_RT_PORT + 1 )) 60 0.03)
        else
          ip=$PEER ipf=()
          for k in $(seq 12); do ping -c1 -W1 "$PEER" &>/dev/null && break; sleep 0.3; done
          (( k < 12 )) || { echo "no connection"; echo "$t fail" >> "$res"; continue; }
          read -r loss rtt jit < <(ping_stats "$PEER" 60 0.03)
          if fgt "$loss" 50; then echo "blocked (${loss}% loss)"; echo "$t blocked $loss" >> "$res"; continue; fi
          # largest packet that really gets through (a black-holed MTU stalls big transfers)
          for sz in "$MTU" 1400 1360 1280 1200; do
            (( sz <= MTU )) || continue
            ping -M do -c 2 -i 0.2 -W 1 -s $((sz - 28)) "$PEER" &>/dev/null && { pm=$sz; break; }
          done
        fi
        local IP3=(timeout 15 iperf3 -c "$ip" "${ipf[@]}" --connect-timeout 3000 -J)
        "${IP3[@]}" -u -b 2M -l 200 -t 3 > "$tmp/u.json" 2>/dev/null
        ujit=$(jget "$tmp/u.json" "d['end']['sum']['jitter_ms']"); uloss=$(jget "$tmp/u.json" "d['end']['sum']['lost_percent']")
        read -r -a c1 < <(cpu_snap)
        local lpid=
        if is_port_tun; then udp_ping 127.0.0.1 $(( BENCH_RT_PORT + 1 )) 40 0.1 > "$tmp/lp" 2>/dev/null & lpid=$!
        else ping -n -q -c 40 -i 0.1 -W 1 "$PEER" > "$tmp/lp" 2>/dev/null & lpid=$!; fi
        "${IP3[@]}" -P 4 -t 5 > "$tmp/up.json" 2>/dev/null
        [[ -n $lpid ]] && wait "$lpid"   # only the ping: a bare wait would also wait on the tunnel processes forever
        read -r -a c2 < <(cpu_snap)
        if is_port_tun; then lrtt=$(awk '{print $2}' "$tmp/lp"); else lrtt=$(sed -n 's#.*= [0-9.]*/\([0-9.]*\)/.*#\1#p' "$tmp/lp"); fi
        lrtt=${lrtt:--}
        "${IP3[@]}" -P 4 -t 5 -R > "$tmp/dn.json" 2>/dev/null
        read -r -a c3 < <(cpu_snap)
        cpu=$(cpu_pct "${c1[@]}" "${c2[@]}") cpd=$(cpu_pct "${c2[@]}" "${c3[@]}")
        up=$(jget "$tmp/up.json" "d['end']['sum_received']['bits_per_second']/1e6")
        dn=$(jget "$tmp/dn.json" "d['end']['sum_received']['bits_per_second']/1e6")
        echo "up ${up} / down ${dn} Mbit/s"
        echo "$t ok $rtt $jit $loss $ujit $uloss $lrtt $up $dn $cpu ${pm:--} $cpd" >> "$res"
      done
      bench_score "$bavg" "$res"
      info "finished in ${SECONDS}s"
      rm -rf -- "$tmp" ;;
    *) die "usage: lighttun bench serve|run <other-server-ip>" ;;
  esac
}

bench_score() {   # baseline_rtt results_file
  python3 - "$1" "$2" <<'PY'
import sys
def f(x):
    try: return float(x)
    except Exception: return None
base = f(sys.argv[1])
rows = []
for line in open(sys.argv[2]):
    p = line.split()
    if len(p) < 11 or p[1] != 'ok':
        rows.append(dict(t=p[0], ok=False, why=('BLOCKED (%s%% loss)' % p[2]) if p[1] == 'blocked' else 'NO CONNECTION')); continue
    rows.append(dict(t=p[0], ok=True, rtt=f(p[2]), jit=f(p[3]), loss=f(p[4]) or 0, ujit=f(p[5]), uloss=f(p[6]),
                     lrtt=f(p[7]), up=f(p[8]) or 0, dn=f(p[9]) or 0, cpu=f(p[10]) or 0, mtu=p[11] if len(p) > 11 else '-',
                     cpd=f(p[12]) if len(p) > 12 else None))
good = [r for r in rows if r['ok'] and (r['up'] + r['dn']) > 0]
for r in rows:
    if r['ok'] and r not in good: r.update(ok=False, why='NO DATA (connects, but transfers fail)')
print()
print(f"Baseline ping (no tunnel): {base if base is not None else '-'} ms")
print()
if good:
    maxthr = max((r['up'] + r['dn']) / 2 for r in good) or 1
    for r in good:
        over = max(0, r['rtt'] - base) if (base and r['rtt'] is not None) else 0
        bloat = max(0, r['lrtt'] - r['rtt']) if (r['lrtt'] is not None and r['rtt'] is not None) else 50
        g = 100 - 2*over - 3*(r['jit'] or 0) - 3*(r['ujit'] or 0) - 8*(r['uloss'] if r['uloss'] is not None else 10) - 8*r['loss'] - 0.3*bloat
        if r['t'] in ('rathole', 'bp', 'bpmux', 'ltcar'): g = min(g, 30)   # TCP-based: head-of-line blocking makes it poor for games
        r['g'] = max(0, min(100, g))
        # CPU cost per Gbit/s moved, over the upload and download tests (raw CPU% says little: a slow tunnel looks cheap)
        cpd = r['cpd'] if r['cpd'] is not None else r['cpu']
        r['cpu'] = (r['cpu'] + cpd) / 2
        r['cpg'] = r['cpu'] * 2000 / max(r['up'] + r['dn'], 1)
        r['eff'] = 1 / max(r['cpg'], 0.5)
    maxeff = max(r['eff'] for r in good) or 1
    for r in good:
        thr = (r['up'] + r['dn']) / 2
        r['b'] = max(0, min(100, 70*thr/maxthr + 20*r['eff']/maxeff + 10*(1 - min(r['loss'], 10)/10)))
    def s(v, fmt="{:.1f}"): return "-" if v is None else fmt.format(v)
    print(f"{'TUNNEL':<8} {'RTT':>6} {'JIT':>5} {'LOSS%':>5} {'UDPJIT':>6} {'UDPLOSS':>7} {'LOADED':>7} {'UP Mb':>7} {'DOWN Mb':>8} {'CPU%':>5} {'CPU/G':>5} {'MTU':>5}   {'GAMING':>6} {'BULK':>5}")
    for r in sorted(good, key=lambda r: -r['g']):
        print(f"{r['t']:<8} {s(r['rtt']):>6} {s(r['jit']):>5} {s(r['loss']):>5} {s(r['ujit']):>6} {s(r['uloss']):>7} {s(r['lrtt']):>7} "
              f"{s(r['up'],'{:.0f}'):>7} {s(r['dn'],'{:.0f}'):>8} {s(r['cpu']):>5} {s(r['cpg'],'{:.0f}'):>5} {r['mtu']:>5}   {r['g']:>6.0f} {r['b']:>5.0f}")
for r in rows:
    if not r['ok']: print(f"{r['t']:<8} {r['why']}")
print()
if good:
    bg = max(good, key=lambda r: r['g']); bb = max(good, key=lambda r: r['b'])
    print(f"Best for gaming: {bg['t']}  (score {bg['g']:.0f}/100)")
    print(f"Best for bulk/VPN traffic: {bb['t']}  (score {bb['b']:.0f}/100)")
else:
    print("No tunnel type worked on this route.")
print("Kernel tunnels and wg are opened by the abroad side: create them with --opener me (abroad) / --opener peer (Iran).")
print("fecraw = FEC in fake TCP, fecrev = FEC over UDP opened by the abroad side, fecicmp = FEC disguised as ping,")
print("rathole / bp / bpmux = reverse TCP port tunnels (BackPack: warm pool, mux), bpkcp = BackPack over UDP+KCP+FEC,")
print("ltcar = reverse port tunnel with one warm TCP connection per user connection / UDP flow (no mux).")
print("vxmux = vxlan spread over 16 UDP flows (--flows 16): gets past per-flow speed limits.")
print("RTT/JIT ms from 60 pings (port tunnels: UDP echo); UDP* from a game-like stream; LOADED = ping during upload;")
print("UP/DOWN = TCP Mbit/s (4 streams); CPU% = this server's CPU during the transfers;")
print("CPU/G = CPU% per Gbit/s moved (lower = lighter); MTU = largest packet that passed.")
PY
}

# ---------------------------------------------------------------- menu

banner() {
  echo "${C}${W}  LightTun ${VERSION}${N}  ${D}lightweight tunnels for gaming + bulk traffic${N}"
  echo
}

menu_qos() {
  local c
  echo "  1) Turn on   2) Turn off   3) Show status"
  read -rp "> " c
  case $c in 1) cmd_qos on ;; 2) cmd_qos off ;; 3) cmd_qos status ;; esac
}

menu_bench() {
  local c ip
  echo "  Run 'Wait for test' on the other server FIRST, then 'Start test' here."
  echo "  1) Wait for test (this is server B)"
  echo "  2) Start test    (this is server A)"
  read -rp "> " c
  read -rp "Other server's public IP: " ip
  case $c in 1) cmd_bench serve "$ip" ;; 2) cmd_bench run "$ip" ;; esac
}

menu_tunnel_ctl() {
  local n c
  n=$(pick_tunnel) || return
  echo "  1) Restart   2) Stop   3) Start"
  read -rp "> " c
  case $c in 1) for_tunnels restart "$n" ;; 2) for_tunnels down "$n" ;; 3) for_tunnels up "$n" ;; esac
}

cmd_menu() {
  need_root
  local c
  while true; do
    clear
    banner
    cmd_status 2>/dev/null; echo
    cat <<EOF
  ${W}Tunnels${N}
   1) Add tunnel                 4) Start / stop / restart
   2) Edit tunnel                5) Command for the other server
   3) Delete tunnel              6) Health check now
  ${W}Tools${N}
   7) Gaming priority (QoS)      8) Benchmark tunnel types
   9) Telegram alerts           10) Optimize server
  11) Install FEC + udp2raw     12) Install rathole
  13) Install BackPack          14) Install ltcar
   0) Exit
EOF
    read -rp "> " c; echo
    [[ $c == 0 || $c == q ]] && exit 0
    # each action runs in a subshell so an input error returns here instead of closing the menu
    (
      case $c in
        1) cmd_add ;;
        2) cmd_edit ;;
        3) cmd_del ;;
        4) menu_tunnel_ctl ;;
        5) cmd_peer ;;
        6) cmd_health ;;
        7) menu_qos ;;
        8) menu_bench ;;
        9) cmd_telegram ;;
        10) cmd_optimize ;;
        11) install_fec ;;
        12) install_rathole ;;
        13) install_backpack ;;
        14) install_ltcar ;;
        *) warn "unknown choice" ;;
      esac
    )
    echo; read -rp "Press Enter to return to the menu..." _
  done
}

usage() {
  cat <<EOF
LightTun $VERSION

  lighttun                         interactive menu
  lighttun add [--name N --type gre|ipip|vxlan|fou|wg|fec|rathole|backpack|ltcar --local IP --remote IP --addr CIDR
               --peer IP --priority gaming|normal|bulk --mtu N --key N --port N --vni N
               --role server|client --secret S --raw yes|no --fec 2:4 --tcp "443 8080" --udp "51820"
               --backup TUNNEL --opener me|peer --carrier tcp|tcpmux|kcp --flows N]
  lighttun edit [NAME]             edit interactively (or with the same flags)
  lighttun set NAME KEY=VALUE...   change settings, e.g. lighttun set fnland MTU=1400 PRIORITY=gaming
  lighttun del NAME [-y]           delete a tunnel
  lighttun list | status | health  show tunnels / live state / run checks now
  lighttun up|down|restart [NAME|all]
  lighttun peer NAME               print the matching command for the other server
  lighttun qos on [--wan IF --bw 900mbit] | off | status
  lighttun bench serve|run IP [TYPES]  benchmark tunnel types between two servers (default: all)
  lighttun telegram                set up Telegram alerts
  lighttun optimize                apply server tuning
  lighttun install fec|rathole|backpack|ltcar [FILE]  install optional userspace tunnels
                                   (ltcar is built from source; FILE = an ltcar binary copied from another server)
  lighttun setup | uninstall
EOF
}

main() {
  local c=$1; shift 2>/dev/null
  [[ $c =~ ^(-v|--version|version|-h|--help|help)$ ]] || need_root
  case $c in
    "") cmd_menu ;;
    add) cmd_add "$@" ;;
    edit) cmd_edit "$@" ;;
    set) cmd_set "$@" ;;
    del|delete|rm) cmd_del "$@" ;;
    list|ls) cmd_list ;;
    status|st) cmd_status ;;
    health) cmd_health ;;
    up|down|restart) need_root; for_tunnels "$c" "$1" ;;
    peer) cmd_peer "$@" ;;
    qos) cmd_qos "$@" ;;
    bench) cmd_bench "$@" ;;
    telegram) cmd_telegram ;;
    optimize) cmd_optimize ;;
    install) case $1 in fec) install_fec ;; rathole) install_rathole ;; backpack) install_backpack ;; ltcar) install_ltcar "$2" ;;
             *) die "install fec|rathole|backpack|ltcar" ;; esac ;;
    setup) cmd_setup ;;
    uninstall) cmd_uninstall ;;
    monitor) cmd_monitor ;;
    _up|_down|_run|_post|_ka) "cmd_$c" "$@" ;;
    _boot) cmd__boot ;;
    -v|--version|version) echo "$VERSION" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
