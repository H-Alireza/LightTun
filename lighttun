#!/usr/bin/env bash
# LightTun - lightweight tunnel manager for Ubuntu servers.
# Kernel tunnels (GRE, IPIP, VXLAN, GRE-over-UDP/FOU, WireGuard), FEC gaming tunnel (tinyfecVPN + udp2raw),
# reverse port tunnels (rathole, BackPack with a warm connection pool / KCP+FEC, ltcar = split TCP with one warm
# connection per user), gaming priority QoS, health monitor with failover, and a benchmark.
set -o pipefail

VERSION="0.1.0"
REPO="H-Alireza/LightTun"
BIN=/usr/local/bin/lighttun
ETC=/etc/lighttun
TDIR=$ETC/tunnels
GCONF=$ETC/lighttun.conf
STATE=/var/lib/lighttun
OPT=/opt/lighttun
UNITDIR=/etc/systemd/system

TYPES="gre ipip vxlan fou wg fec rathole backpack ltcar"
TVARS=(NAME TYPE LOCAL_IP REMOTE_IP ADDR PEER MTU TTL PRIORITY PORT KEY VNI ROLE SECRET FEC FEC_TIMEOUT FEC_MODE RAW FWD_TCP FWD_UDP BACKUP CHECK INTERVAL MAX_LOSS MAX_JITTER OPENER CARRIER FLOWS)

if [[ -t 1 ]]; then R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' D=$'\e[2m' W=$'\e[1m' N=$'\e[0m'; else R='' G='' Y='' C='' D='' W='' N=''; fi
info() { echo "${C}[*]${N} $*"; }
ok()   { echo "${G}[+]${N} $*"; }
warn() { echo "${Y}[!]${N} $*" >&2; }
die()  { echo "${R}[x]${N} $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root"; }
ipt() { iptables -w "$@"; }
fgt() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a+0>b+0)}'; }
is_ip() { [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
is_cidr() { [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]; }
is_num() { [[ $1 =~ ^[0-9]+$ ]]; }
rand_secret() { head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
wan_dev() { ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+'; }
src_ip_for() { ip -4 route get "${1:-1.1.1.1}" 2>/dev/null | grep -oP 'src \K\S+'; }

# ---------------------------------------------------------------- config

load_global() {
  QOS_WAN="" QOS_BW="" TG_TOKEN="" TG_CHAT="" TG_PROXY="" NODE_NAME="$(hostname)"
  [[ -f $GCONF ]] && . "$GCONF"
}

save_global() {
  mkdir -p "$ETC"
  {
    for v in QOS_WAN QOS_BW TG_TOKEN TG_CHAT TG_PROXY NODE_NAME; do printf '%s=%q\n' "$v" "${!v}"; done
  } > "$GCONF"
  chmod 600 "$GCONF"
}

reset_tunnel() { for v in "${TVARS[@]}"; do printf -v "$v" '%s' ''; done; }

tunnel_defaults() {
  : "${TTL:=255}" "${PRIORITY:=normal}" "${CHECK:=yes}" "${MAX_LOSS:=5}" "${RAW:=no}"
  if [[ $PRIORITY == gaming ]]; then : "${INTERVAL:=5}" "${MAX_JITTER:=15}"; else : "${INTERVAL:=15}" "${MAX_JITTER:=40}"; fi
  case $TYPE in
    gre)   : "${MTU:=1420}" ;;
    ipip)  : "${MTU:=1440}" ;;
    vxlan) : "${MTU:=1400}" "${PORT:=4789}" "${VNI:=100}" "${FLOWS:=1}" ;;
    fou)   : "${MTU:=1400}" "${PORT:=5555}" ;;
    wg)    : "${MTU:=1420}" "${PORT:=51830}" ;;
    fec)   : "${MTU:=1300}" "${PORT:=4096}"
           if [[ $PRIORITY == gaming ]]; then : "${FEC:=2:4}" "${FEC_TIMEOUT:=1}" "${FEC_MODE:=1}"
           else : "${FEC:=20:10}" "${FEC_TIMEOUT:=8}" "${FEC_MODE:=0}"; fi ;;
    rathole) : "${PORT:=2333}" ;;
    backpack) : "${PORT:=2334}" "${CARRIER:=tcp}" ;;
    ltcar) : "${PORT:=2335}" ;;
  esac
}

load_tunnel() {
  reset_tunnel
  [[ -f $TDIR/$1.conf ]] || die "no tunnel named '$1'"
  . "$TDIR/$1.conf"
  tunnel_defaults
}

save_tunnel() {
  mkdir -p "$TDIR"
  { for v in "${TVARS[@]}"; do printf '%s=%q\n' "$v" "${!v}"; done; } > "$TDIR/$NAME.conf"
  chmod 600 "$TDIR/$NAME.conf"
}

tunnel_names() { local f; for f in "$TDIR"/*.conf; do [[ -e $f ]] && basename "$f" .conf; done; }
tvar() { ( . "$TDIR/$1.conf" 2>/dev/null; echo "${!2}" ); }   # read one var of another tunnel
is_port_tun() { [[ $TYPE =~ ^(rathole|backpack|ltcar)$ ]]; }   # carries listed ports, no tunnel interface
is_l3() { ! is_port_tun; }
is_kernel() { [[ $TYPE =~ ^(gre|ipip|vxlan|fou|wg)$ ]]; }
unit_of() { case $TYPE in fec|rathole|backpack|ltcar) echo "lighttun-proc@$NAME.service" ;; *) echo "lighttun@$NAME.service" ;; esac; }
tos_of() { case $PRIORITY in gaming) echo 0xb8 ;; bulk) echo 0x20 ;; *) echo 0x00 ;; esac; }   # EF / CS1 / CS0
dscp_of() { case $PRIORITY in gaming) echo 46 ;; bulk) echo 8 ;; *) echo 0 ;; esac; }
other_host() { local ip=${1%/*} o; o=${ip##*.}; if (( o % 2 )); then echo "${ip%.*}.$((o + 1))"; else echo "${ip%.*}.$((o - 1))"; fi; }

validate_tunnel() {
  [[ $NAME =~ ^[a-z0-9][a-z0-9_-]{0,11}$ ]] || die "name must be 1-12 chars: a-z 0-9 _ -"
  [[ " $TYPES " == *" $TYPE "* ]] || die "type must be one of: $TYPES"
  [[ $PRIORITY =~ ^(gaming|normal|bulk)$ ]] || die "priority must be gaming, normal or bulk"
  is_ip "$LOCAL_IP" || die "bad local IP: $LOCAL_IP"
  is_ip "$REMOTE_IP" || die "bad remote IP: $REMOTE_IP"
  if is_l3; then
    is_cidr "$ADDR" || die "bad tunnel address (use x.x.x.x/30): $ADDR"
    is_ip "$PEER" || die "bad peer tunnel IP: $PEER"
    is_num "$MTU" || die "bad MTU"
  fi
  [[ -z $KEY ]] || is_num "$KEY" || die "GRE key must be a number"
  case $TYPE in
    vxlan) is_num "$VNI" || die "VXLAN needs a numeric VNI"
           [[ $FLOWS =~ ^[0-9]+$ ]] && (( FLOWS >= 1 && FLOWS <= 64 )) || die "flows must be 1-64" ;;
    wg)    [[ -n $SECRET ]] || die "wg needs a secret (both keys are derived from it)"
           command -v wg >/dev/null || die "wg missing: apt install wireguard-tools" ;;
    backpack)
      [[ $CARRIER =~ ^(tcp|tcpmux|kcp)$ ]] || die "backpack carrier must be tcp, tcpmux or kcp" ;;&
    fec|rathole|backpack|ltcar)
      [[ $ROLE =~ ^(server|client)$ ]] || die "$TYPE needs role server or client"
      [[ -n $SECRET ]] || die "$TYPE needs a secret" ;;
  esac
  [[ $TYPE =~ ^(vxlan|fou|wg|fec|rathole|backpack|ltcar)$ ]] && { is_num "$PORT" || die "$TYPE needs a port"; }
  [[ -z $OPENER || $OPENER =~ ^(me|peer)$ ]] || die "opener must be me, peer or empty"
  [[ -z $OPENER ]] || is_kernel || die "opener is for kernel tunnels (fec/rathole/backpack/ltcar already have a role)"
  [[ $RAW =~ ^(yes|no|icmp)$ ]] || die "raw must be yes (fake TCP), icmp or no"
  if [[ $TYPE == fec ]]; then
    local want=1; [[ $ROLE == client ]] && want=2
    [[ ${ADDR%/*} == "${ADDR%.*}.$want" ]] || die "fec $ROLE address must end in .$want (e.g. ${ADDR%.*}.$want/24)"
  fi
  if is_port_tun; then
    [[ -n $FWD_TCP$FWD_UDP ]] || die "$TYPE needs at least one TCP or UDP port to carry"
    [[ "$FWD_TCP $FWD_UDP" != *:* ]] || die "$TYPE does not support port ranges"
  fi
  [[ -z $BACKUP || -f $TDIR/$BACKUP.conf ]] || die "backup tunnel '$BACKUP' does not exist"
  [[ $BACKUP != "$NAME" ]] || die "a tunnel cannot be its own backup"
  # interface name must not collide with a non-LightTun interface
  if [[ ! -f $TDIR/$NAME.conf ]] && ip link show "$NAME" &>/dev/null; then die "interface '$NAME' already exists on this system"; fi
  # GRE-family (gre/fou) tunnels to the same remote need distinct keys; IPIP cannot be doubled
  local n t
  for n in $(tunnel_names); do
    [[ $n == "$NAME" ]] && continue
    [[ $(tvar "$n" REMOTE_IP) == "$REMOTE_IP" && $(tvar "$n" LOCAL_IP) == "$LOCAL_IP" ]] || continue
    t=$(tvar "$n" TYPE)
    if [[ $TYPE =~ ^(gre|fou)$ && $t =~ ^(gre|fou)$ && $(tvar "$n" KEY) == "$KEY" ]]; then
      die "tunnel '$n' already uses GRE to $REMOTE_IP with key '${KEY:-none}' - set a different --key"
    fi
    # a multi-flow vxlan also uses the FLOWS ports above its own
    if [[ $TYPE == vxlan && $t =~ ^(vxlan|fou|wg)$ ]]; then
      local p f; p=$(tvar "$n" PORT) f=$(tvar "$n" FLOWS); [[ $t == vxlan && ${f:-1} -gt 1 ]] || f=0
      (( (f > 0 || FLOWS > 1) && p + f >= PORT && p <= PORT + (FLOWS > 1 ? FLOWS : 0) )) && \
        die "tunnel '$n' uses port $p, which overlaps this tunnel's ports (vxlan flows use the ports above the tunnel port)"
    fi
    [[ $TYPE == ipip && $t == ipip ]] && die "tunnel '$n' is already IPIP to $REMOTE_IP; use GRE with a key for a second tunnel"
  done
  return 0
}

# ---------------------------------------------------------------- firewall

HOOKS=("filter INPUT" "filter OUTPUT" "filter FORWARD" "nat PREROUTING" "nat POSTROUTING" "mangle FORWARD" "mangle OUTPUT" "mangle POSTROUTING" "raw PREROUTING" "raw OUTPUT")
chain_name() { echo "LT_${1}_${2:0:4}"; }

fw_chain() {   # table hook tunnel -> creates/flushes the tunnel's chain, hooks it in, prints its name
  local t=$1 h=$2 c; c=$(chain_name "$3" "$h")
  ipt -t "$t" -N "$c" 2>/dev/null || ipt -t "$t" -F "$c"
  ipt -t "$t" -C "$h" -j "$c" 2>/dev/null || ipt -t "$t" -I "$h" 1 -j "$c"
  echo "$c"
}

fw_clear() {
  local th t h c
  for th in "${HOOKS[@]}"; do
    read -r t h <<<"$th"; c=$(chain_name "$1" "$h")
    while ipt -t "$t" -D "$h" -j "$c" 2>/dev/null; do :; done
    ipt -t "$t" -F "$c" 2>/dev/null; ipt -t "$t" -X "$c" 2>/dev/null
  done
  return 0
}

outer_match() {   # iptables match for this tunnel's outer packets
  case $TYPE in
    gre)  echo "-p gre" ;;
    ipip) echo "-p 4" ;;
    vxlan|fou|wg) echo "-p udp --dport $PORT" ;;
  esac
}

fw_apply() {   # loaded tunnel
  local c m dscp p
  fw_clear "$NAME"
  m=$(outer_match)

  c=$(fw_chain filter INPUT "$NAME")
  if [[ -n $m && $OPENER == peer ]]; then
    ipt -A "$c" -s "$REMOTE_IP" $m -m recent --name "lt_$NAME" --rsource --set -j ACCEPT
    # the peer's flow openers (see flow_opener): only there to open the route, never answered
    [[ $TYPE == vxlan ]] && (( FLOWS > 1 )) && ipt -A "$c" -s "$REMOTE_IP" -p udp --dport "$((PORT + 1)):$((PORT + FLOWS))" -j DROP
  elif [[ -n $m ]]; then
    ipt -A "$c" -s "$REMOTE_IP" $m -j ACCEPT
  fi
  case $TYPE in
    fec)
      ipt -A "$c" -s "$REMOTE_IP" -p udp -m multiport --ports "$PORT" -j ACCEPT
      ipt -A "$c" -s "$REMOTE_IP" -p tcp -m multiport --ports "$PORT" -j ACCEPT
      [[ $RAW == icmp ]] && ipt -A "$c" -s "$REMOTE_IP" -p icmp -j ACCEPT ;;
    rathole|backpack|ltcar)
      if [[ $ROLE == server ]]; then
        ipt -A "$c" -s "$REMOTE_IP" -p tcp --dport "$PORT" -j ACCEPT
        [[ $CARRIER == kcp ]] && ipt -A "$c" -s "$REMOTE_IP" -p udp --dport "$PORT" -j ACCEPT
        for p in $FWD_TCP; do ipt -A "$c" -p tcp --dport "$p" -j ACCEPT; done
        for p in $FWD_UDP; do ipt -A "$c" -p udp --dport "$p" -j ACCEPT; done
      fi ;;
  esac
  is_l3 && ipt -A "$c" -i "$NAME" -j ACCEPT

  if is_l3; then
    c=$(fw_chain filter FORWARD "$NAME")
    ipt -A "$c" -i "$NAME" -j ACCEPT
    ipt -A "$c" -o "$NAME" -j ACCEPT
    # MSS clamping: keeps big TCP transfers from stalling on the smaller tunnel MTU
    for h in FORWARD OUTPUT; do
      c=$(fw_chain mangle "$h" "$NAME")
      ipt -t mangle -A "$c" -o "$NAME" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    done
    # traffic leaving the tunnel toward clients keeps the tunnel's class, so QoS can put gaming first downstream too
    dscp=$(dscp_of)
    [[ $dscp != 0 ]] && ipt -t mangle -A "$(chain_name "$NAME" FORWARD)" -i "$NAME" -j DSCP --set-dscp "$dscp"
  fi

  # opener=peer: never send first. Filtered routes (e.g. Iran -> abroad) cut a flow this side starts and keep
  # it cut while this side keeps sending; flows the other side opens pass. So outer packets only leave while
  # the peer was heard from in the last 10 s (it sends a keepalive every second).
  if [[ -n $m && $OPENER == peer ]]; then
    c=$(fw_chain filter OUTPUT "$NAME")
    ipt -A "$c" -d "$REMOTE_IP" $m -m recent --name "lt_$NAME" --rdest --rcheck --seconds 10 -j RETURN
    ipt -A "$c" -d "$REMOTE_IP" $m -j DROP
  fi

  # skip conntrack for kernel tunnels' outer packets (saves CPU under heavy traffic)
  if [[ -n $m ]]; then
    c=$(fw_chain raw PREROUTING "$NAME"); ipt -t raw -A "$c" -s "$REMOTE_IP" $m -j CT --notrack
    c=$(fw_chain raw OUTPUT "$NAME");     ipt -t raw -A "$c" -d "$REMOTE_IP" $m -j CT --notrack
  fi
  # and for a port tunnel server's sockets: the tunnel port and the users' ports end in a local process, so
  # nothing needs their state, and a relay with thousands of users spends real CPU tracking them (the INPUT
  # rules above accept them by port, so a stateful firewall still lets them in)
  if is_port_tun && [[ $ROLE == server ]]; then
    local pre out tp up
    pre=$(fw_chain raw PREROUTING "$NAME") out=$(fw_chain raw OUTPUT "$NAME")
    tp=$(printf '%s\n' $FWD_TCP | paste -sd, -) up=$(printf '%s\n' $FWD_UDP | paste -sd, -)
    ipt -t raw -A "$pre" -s "$REMOTE_IP" -p tcp --dport "$PORT" -j CT --notrack
    ipt -t raw -A "$out" -d "$REMOTE_IP" -p tcp --sport "$PORT" -j CT --notrack
    [[ $CARRIER == kcp ]] && { ipt -t raw -A "$pre" -s "$REMOTE_IP" -p udp --dport "$PORT" -j CT --notrack
                               ipt -t raw -A "$out" -d "$REMOTE_IP" -p udp --sport "$PORT" -j CT --notrack; }
    [[ -n $tp ]] && { ipt -t raw -A "$pre" ! -i lo -p tcp -m multiport --dports "$tp" -j CT --notrack
                      ipt -t raw -A "$out" ! -o lo -p tcp -m multiport --sports "$tp" -j CT --notrack; }
    [[ -n $up ]] && { ipt -t raw -A "$pre" ! -i lo -p udp -m multiport --dports "$up" -j CT --notrack
                      ipt -t raw -A "$out" ! -o lo -p udp -m multiport --sports "$up" -j CT --notrack; }
  fi

  # userspace tunnels and wg: priority mark on outer packets (the other kernel tunnels set it with "tos")
  dscp=$(dscp_of)
  if [[ $TYPE =~ ^(fec|rathole|backpack|ltcar|wg)$ && $dscp != 0 ]]; then
    c=$(fw_chain mangle POSTROUTING "$NAME")
    for p in udp tcp; do ipt -t mangle -A "$c" -d "$REMOTE_IP" -p $p -m multiport --ports "$PORT" -j DSCP --set-dscp "$dscp"; done
  fi

  is_l3 && fw_forward "$NAME"
  return 0
}

# DNAT this tunnel's forwarded ports to the peer of tunnel $1 (itself, or its backup during failover)
fw_forward() {
  local via=$1 peer dev c p
  [[ -n $FWD_TCP$FWD_UDP ]] || return 0
  if [[ $via == "$NAME" ]]; then peer=$PEER; else peer=$(tvar "$via" PEER); fi
  dev=$via
  c=$(fw_chain nat PREROUTING "$NAME")
  for p in $FWD_TCP; do ipt -t nat -A "$c" ! -i "$dev" -m addrtype --dst-type LOCAL -p tcp --dport "$p" -j DNAT --to-destination "$peer"; done
  for p in $FWD_UDP; do ipt -t nat -A "$c" ! -i "$dev" -m addrtype --dst-type LOCAL -p udp --dport "$p" -j DNAT --to-destination "$peer"; done
  c=$(fw_chain nat POSTROUTING "$NAME")
  ipt -t nat -A "$c" -o "$dev" -d "$peer" -j MASQUERADE
  echo "$via" > "$STATE/$NAME.via" 2>/dev/null
  return 0
}

# ---------------------------------------------------------------- link setup

fou_port_in_use() {   # another active fou tunnel uses this port?
  local n
  for n in $(tunnel_names); do
    [[ $n != "$NAME" && $(tvar "$n" TYPE) == fou && $(tvar "$n" PORT) == "$PORT" ]] && ip link show "$n" &>/dev/null && return 0
  done
  return 1
}

link_up() {   # kernel tunnel types
  local tos; tos=$(tos_of)
  ip link del "$NAME" 2>/dev/null
  case $TYPE in
    gre)   modprobe ip_gre 2>/dev/null
           ip link add "$NAME" type gre local "$LOCAL_IP" remote "$REMOTE_IP" ttl "$TTL" tos "$tos" ${KEY:+key $KEY} ;;
    ipip)  modprobe ipip 2>/dev/null
           ip link add "$NAME" type ipip local "$LOCAL_IP" remote "$REMOTE_IP" ttl "$TTL" tos "$tos" ;;
    vxlan) modprobe vxlan 2>/dev/null
           # with an opener the source ports are fixed, so the tunnel is flows the abroad side opened: one flow
           # (port -> port), or FLOWS flows (port+1..port+FLOWS -> port; vxlan hashes each inner connection onto one).
           # Many flows get past per-flow shaping and spread the receiving side's work over its CPU cores.
           local sp=(); [[ -n $OPENER ]] && sp=(srcport "$PORT" "$((PORT + 1))")
           [[ -n $OPENER ]] && (( FLOWS > 1 )) && sp=(srcport "$((PORT + 1))" "$((PORT + 1 + FLOWS))")
           ip link add "$NAME" type vxlan id "$VNI" local "$LOCAL_IP" remote "$REMOTE_IP" dstport "$PORT" ttl "$TTL" tos "$tos" "${sp[@]}" ;;
    fou)   modprobe fou 2>/dev/null; modprobe ip_gre 2>/dev/null
           ip fou add port "$PORT" ipproto 47 2>/dev/null
           local esp=auto; [[ -n $OPENER ]] && esp=$PORT   # fixed source port: one flow, opened by the abroad side
           ip link add "$NAME" type gre local "$LOCAL_IP" remote "$REMOTE_IP" ttl "$TTL" tos "$tos" ${KEY:+key $KEY} \
             encap fou encap-sport "$esp" encap-dport "$PORT" ;;
    wg)    modprobe wireguard 2>/dev/null
           ip link add "$NAME" type wireguard || return 1
           local wa=(listen-port "$PORT" peer "$(wg_priv "$REMOTE_IP" | wg pubkey)" allowed-ips 0.0.0.0/0)
           # opener=peer: no endpoint, so this side never starts the flow; it answers wherever the peer's handshake came from
           [[ $OPENER == peer ]] || wa+=(endpoint "$REMOTE_IP:$PORT" persistent-keepalive "$([[ $OPENER == me ]] && echo 1 || echo 25)")
           # <(...) must be in the wg command itself: its pipe closes when the statement that made it ends
           wg set "$NAME" private-key <(wg_priv "$LOCAL_IP") "${wa[@]}" || { ip link del "$NAME"; return 1; } ;;
    *) return 1 ;;
  esac || return 1
  ip addr add "$ADDR" dev "$NAME" || return 1
  ip link set "$NAME" mtu "$MTU" up
}

wg_priv() {   # public IP -> that side's WireGuard private key, derived from the shared secret
  python3 -c 'import base64,hashlib,sys; print(base64.b64encode(hashlib.sha256(sys.argv[1].encode()).digest()).decode())' "lighttun-wg:$SECRET:$1"
}

link_down() {
  ip link del "$NAME" 2>/dev/null
  [[ $TYPE == fou ]] && ! fou_port_in_use && ip fou del port "$PORT" 2>/dev/null
  return 0
}

fec_run() {   # foreground: tinyfecVPN (+ udp2raw in front when RAW=yes (fake TCP) or RAW=icmp)
  local sub="${ADDR%.*}.0" fport=$PORT pids=() wrap=no rmode=faketcp
  [[ -x $OPT/tinyvpn ]] || die "tinyfecVPN missing - run: lighttun install fec"
  local fec=(-f"$FEC" -k "$SECRET" --sub-net "$sub" --tun-dev "$NAME" --timeout "$FEC_TIMEOUT" --mode "$FEC_MODE" --log-level 3)
  [[ $RAW == yes || $RAW == icmp ]] && wrap=yes
  [[ $RAW == icmp ]] && rmode=icmp
  if [[ $wrap == yes ]]; then
    [[ -x $OPT/udp2raw ]] || die "udp2raw missing - run: lighttun install fec"
    fport=$((PORT + 1))
    # --fix-gro: without it udp2raw drops packets the NIC merged (GRO), which cuts throughput
    local raw=(-k "$SECRET" --raw-mode "$rmode" -a --fix-gro --log-level 3)
    if [[ $ROLE == server ]]; then
      "$OPT/udp2raw" -s -l"0.0.0.0:$PORT" -r"127.0.0.1:$fport" "${raw[@]}" & pids+=($!)
    else
      "$OPT/udp2raw" -c -l"127.0.0.1:$fport" -r"$REMOTE_IP:$PORT" "${raw[@]}" & pids+=($!)
    fi
  fi
  if [[ $ROLE == server ]]; then
    local lip=0.0.0.0; [[ $wrap == yes ]] && lip=127.0.0.1
    "$OPT/tinyvpn" -s -l"$lip:$fport" "${fec[@]}" & pids+=($!)
  else
    local rip=$REMOTE_IP; [[ $wrap == yes ]] && rip=127.0.0.1
    "$OPT/tinyvpn" -c -r"$rip:$fport" "${fec[@]}" --keep-reconnect & pids+=($!)
  fi
  trap 'kill "${pids[@]}" 2>/dev/null; [[ $wrap == yes ]] && udp2raw_clear $PORT' EXIT TERM INT
  wait -n
  kill "${pids[@]}" 2>/dev/null
  exit 1
}

rathole_conf() {
  local f=$STATE/rathole-$NAME.toml p
  mkdir -p "$STATE"
  if [[ $ROLE == server ]]; then
    { echo "[server]"; echo "bind_addr = \"0.0.0.0:$PORT\""; echo "default_token = \"$SECRET\""
      echo "[server.transport]"; echo 'type = "tcp"'; echo "[server.transport.tcp]"; echo "nodelay = true"
      for p in $FWD_TCP; do echo "[server.services.t$p]"; echo "bind_addr = \"0.0.0.0:$p\""; done
      for p in $FWD_UDP; do echo "[server.services.u$p]"; echo 'type = "udp"'; echo "bind_addr = \"0.0.0.0:$p\""; done
    } > "$f"
  else
    { echo "[client]"; echo "remote_addr = \"$REMOTE_IP:$PORT\""; echo "default_token = \"$SECRET\""
      echo "[client.transport]"; echo 'type = "tcp"'; echo "[client.transport.tcp]"; echo "nodelay = true"
      for p in $FWD_TCP; do echo "[client.services.t$p]"; echo "local_addr = \"127.0.0.1:$p\""; done
      for p in $FWD_UDP; do echo "[client.services.u$p]"; echo 'type = "udp"'; echo "local_addr = \"127.0.0.1:$p\""; done
    } > "$f"
  fi
  chmod 600 "$f"; echo "$f"
}

bp_bin() { [[ -x $OPT/backpack ]] && echo "$OPT/backpack" || command -v backpack; }   # ours, or one already installed

# BackPack engine config. Same idea as rathole (the abroad side dials in, Iran exposes the ports), plus what makes
# it hold up on filtered routes: a pool of warm connections (no handshake per new user connection), heartbeats,
# and the kcp carrier (reliable UDP with FEC) for gaming. Tuning = BackPack's "turbo" preset; kcp + bulk priority
# gets its "throughput" preset. skip_optz: LightTun's own tuning stays in charge of sysctls.
backpack_conf() {
  local f=$STATE/backpack-$NAME.toml ports udp=false
  mkdir -p "$STATE"
  ports=$(printf '%s\n' $FWD_TCP $FWD_UDP | sort -un | sed 's/.*/"&"/' | paste -sd, -)
  [[ -n $FWD_UDP ]] && udp=true
  {
    if [[ $ROLE == server ]]; then
      echo "[server]"; echo "bind_addr = \"0.0.0.0:$PORT\""
      echo "heartbeat = 40"; echo "channel_size = 4096"; echo "mux_con = 8"
      echo "accept_udp = $udp"; echo "ports = [$ports]"
    else
      echo "[client]"; echo "remote_addr = \"$REMOTE_IP:$PORT\""
      echo "connection_pool = 8"; echo "aggressive_pool = false"; echo "retry_interval = 3"; echo "dial_timeout = 10"
      [[ $CARRIER == tcpmux ]] && echo "mux_session = 8"
    fi
    echo "transport = \"$CARRIER\""; echo "token = \"$SECRET\""
    echo "nodelay = true"; echo "keepalive_period = 75"; echo 'log_level = "warn"'; echo "skip_optz = true"
    echo "so_rcvbuf = 8388608"; echo "so_sndbuf = 8388608"
    echo "mux_version = 2"; echo "mux_framesize = 32768"; echo "mux_recievebuffer = 16777216"; echo "mux_streambuffer = 2097152"
    if [[ $CARRIER == kcp ]]; then
      echo "kcp_mtu = 1250"; echo "kcp_resend = 2"; echo "kcp_nodelay = 1"; echo "kcp_nocongestion = 1"; echo "kcp_datashards = 10"
      if [[ $PRIORITY == bulk ]]; then
        echo "kcp_interval = 20"; echo "kcp_acknodelay = false"; echo "kcp_sndwnd = 4096"; echo "kcp_rcvwnd = 4096"; echo "kcp_parityshards = 1"
      else
        echo "kcp_interval = 10"; echo "kcp_acknodelay = true"; echo "kcp_sndwnd = 1024"; echo "kcp_rcvwnd = 1024"; echo "kcp_parityshards = 3"
      fi
    fi
  } > "$f"
  chmod 600 "$f"; echo "$f"
}

# ltcar (proto/ltcar): the abroad side keeps a pool of warm connections and gives each user connection or UDP
# flow its own one, terminated on both sides, so only one TCP crosses the route and no user waits behind another.
# Carriers are reused with their congestion window intact, and a fixed buffer budget keeps TCP memory bounded.
# The secret goes in through the environment, not argv (ps shows argv to every user).
ltcar_exec() {   # [exec] -> runs ltcar for the loaded tunnel
  local users="" p pre=()
  [[ $1 == exec ]] && pre=(exec)
  for p in $FWD_TCP; do users+="${users:+,}0.0.0.0:$p"; done
  for p in $FWD_UDP; do users+="${users:+,}udp:0.0.0.0:$p"; done
  export LTCAR_TOKEN=$SECRET
  if [[ $ROLE == server ]]; then
    "${pre[@]}" "$OPT/ltcar" server -name "$NAME" -listen "0.0.0.0:$PORT" -users "$users"
  else
    "${pre[@]}" "$OPT/ltcar" client -name "$NAME" -remote "$REMOTE_IP:$PORT" -target 127.0.0.1 -pool 64
  fi
}

# ---------------------------------------------------------------- internal (systemd) commands

cmd__up() {
  load_tunnel "$1"
  fw_apply   # first, so an opener=peer gate is in place before the link can send anything
  link_up || { fw_clear "$NAME"; die "failed to create $TYPE tunnel $NAME"; }
  # opener=me: keep the flow open from this side (wg does it itself with persistent-keepalive)
  [[ $OPENER == me && $TYPE != wg ]] && systemctl start --no-block "lighttun-ka@$NAME.service"
  return 0
}

cmd__ka() {
  load_tunnel "$1"
  [[ $TYPE == vxlan ]] && (( FLOWS > 1 )) && { flow_opener & }
  exec ping -n -q -i 1 -W 1 "$PEER" >/dev/null 2>&1
}

# multi-flow vxlan, opener=me: the peer sends from ports port+1..port+FLOWS to our port. Open each of those flows
# from here, once a second, with a tiny packet from our port to that one (raw socket: the kernel vxlan socket owns
# our port; the peer drops these packets). Our own sends start their flows themselves.
flow_opener() {
  exec python3 -c 'import socket,struct,sys,time  # lighttun-flow-opener
r,p,n=sys.argv[1],int(sys.argv[2]),int(sys.argv[3])
s=socket.socket(socket.AF_INET,socket.SOCK_RAW,socket.IPPROTO_UDP)
while True:
  for i in range(1,n+1):
    try: s.sendto(struct.pack("!HHHH",p,p+i,16,0)+bytes(8),(r,0))
    except OSError: pass
  time.sleep(1)' "$REMOTE_IP" "$PORT" "$FLOWS"
}

cmd__down() {
  load_tunnel "$1"
  systemctl stop --no-block "lighttun-ka@$NAME.service" 2>/dev/null
  fw_clear "$NAME"
  rm -f "$STATE/$NAME.via"
  is_l3 && link_down
  return 0
}

cmd__run() {
  load_tunnel "$1"
  case $TYPE in
    fec) fec_run ;;
    rathole) [[ -x $OPT/rathole ]] || die "rathole missing - run: lighttun install rathole"
             exec "$OPT/rathole" "$(rathole_conf)" ;;
    backpack) [[ -n $(bp_bin) ]] || die "BackPack missing - run: lighttun install backpack"
              exec "$(bp_bin)" -c "$(backpack_conf)" ;;
    ltcar) [[ -x $OPT/ltcar ]] || die "ltcar missing - run: lighttun install ltcar"
           ltcar_exec exec ;;
  esac
}

cmd__post() {
  load_tunnel "$1"
  if [[ $TYPE == fec ]]; then
    local i; for i in $(seq 40); do ip link show "$NAME" &>/dev/null && break; sleep 0.5; done
    ip link set "$NAME" mtu "$MTU" up 2>/dev/null
  fi
  fw_apply
}

cmd__boot() {
  local m; for m in tcp_bbr sch_fq sch_cake nf_conntrack ip_gre ipip fou vxlan wireguard; do modprobe "$m" 2>/dev/null; done
  sysctl -q -e -p /etc/sysctl.d/99-lighttun.conf >/dev/null 2>&1
  local wan; wan=$(wan_dev)
  # bigger NIC ring buffers where the driver allows it
  if [[ -n $wan ]] && command -v ethtool >/dev/null; then
    local rx tx
    rx=$(ethtool -g "$wan" 2>/dev/null | awk '/maximums/{f=1} f&&/^RX:/{print $2; exit}')
    tx=$(ethtool -g "$wan" 2>/dev/null | awk '/maximums/{f=1} f&&/^TX:/{print $2; exit}')
    [[ $rx =~ ^[0-9]+$ ]] && ethtool -G "$wan" rx "$rx" 2>/dev/null
    [[ $tx =~ ^[0-9]+$ ]] && ethtool -G "$wan" tx "$tx" 2>/dev/null
  fi
  for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [[ -w $g ]] && echo performance > "$g" 2>/dev/null; done
  qos_apply quiet
  return 0
}

# ---------------------------------------------------------------- unit control

start_tunnel() {
  local u; u=$(unit_of)
  [[ -f $UNITDIR/lighttun-ka@.service ]] || write_units   # units added by an update
  systemctl enable "$u" >/dev/null 2>&1
  systemctl restart "$u" && ok "tunnel $NAME is up ($u)" || { warn "failed to start $NAME - see: journalctl -u $u -n 30"; return 1; }
}

stop_tunnel() {   # loaded tunnel
  local u; u=$(unit_of)
  systemctl disable --now "$u" >/dev/null 2>&1
  return 0
}

# ---------------------------------------------------------------- user commands

ask() {   # prompt default -> answer
  local a; read -rp "$1 ${D}[${2}]${N}: " a; echo "${a:-$2}"
}

pick_tunnel() {
  local names=($(tunnel_names)) i a
  [[ ${#names[@]} -gt 0 ]] || die "no tunnels yet"
  for i in "${!names[@]}"; do echo "  $((i + 1))) ${names[$i]}" >&2; done
  read -rp "Tunnel number or name: " a
  [[ $a =~ ^[0-9]+$ ]] && a=${names[$((a - 1))]}
  [[ -f $TDIR/$a.conf ]] || die "no tunnel '$a'"
  echo "$a"
}

next_free_net() {
  local i used
  used=$(cat "$TDIR"/*.conf 2>/dev/null | grep -oP '^ADDR=\K[0-9.]+')
  for i in $(seq 10 250); do grep -q "^10\.77\.$i\." <<<"$used" || { echo "10.77.$i"; return; }; done
  echo "10.78.1"
}

wizard() {   # fills tunnel vars interactively; current values are the defaults
  local editing=$1 t
  if [[ -z $editing ]]; then
    NAME=$(ask "Tunnel name (a-z0-9, max 12)" "tun$(( $(tunnel_names | wc -l) + 1 ))")
    echo "Tunnel type:"
    echo "  1) gre      kernel, lowest CPU, best default"
    echo "  2) ipip     kernel, smallest overhead (one per server pair)"
    echo "  3) vxlan    kernel, over UDP - when GRE is blocked"
    echo "  4) fou      kernel, GRE inside UDP - UDP-friendly, almost GRE cost"
    echo "  5) wg       kernel WireGuard - encrypted, low CPU, good for gaming"
    echo "  6) fec      tinyfecVPN - error correction for lossy routes (gaming)"
    echo "  7) rathole  reverse TCP/UDP port tunnel - when the far side can't accept connections"
    echo "  8) backpack reverse port tunnel with a warm connection pool; kcp carrier = UDP+FEC for gaming"
    echo "  9) ltcar    reverse TCP/UDP port tunnel, one warm connection per user (fast downloads, UDP not stuck behind TCP)"
    t=$(ask "Choose 1-9" "1")
    TYPE=$(echo $TYPES | cut -d' ' -f"$t")
    [[ -n $TYPE ]] || die "bad choice"
  fi
  PRIORITY=$(ask "Priority: gaming / normal / bulk" "${PRIORITY:-normal}")
  LOCAL_IP=$(ask "This server's public IP" "${LOCAL_IP:-$(src_ip_for)}")
  REMOTE_IP=$(ask "Other server's public IP" "$REMOTE_IP")
  if [[ $TYPE == fec ]] || is_port_tun; then
    ROLE=$(ask "Role on this server: server (listens) / client (connects out)" "${ROLE:-server}")
  fi
  case $TYPE in
    fec)
      local net=${ADDR%.*}; [[ -n $ADDR ]] || net=$(next_free_net)
      net=$(ask "Tunnel /24 network (server gets .1, client .2)" "$net")
      if [[ $ROLE == server ]]; then ADDR=$net.1/24 PEER=$net.2; else ADDR=$net.2/24 PEER=$net.1; fi ;;
    rathole|backpack|ltcar) ;;
    *)
      ADDR=$(ask "This side's tunnel address" "${ADDR:-$(next_free_net).1/30}")
      PEER=$(ask "Other side's tunnel IP" "${PEER:-$(other_host "$ADDR")}") ;;
  esac
  local saved_mtu=$MTU; [[ -z $editing ]] && MTU=""
  tunnel_defaults
  [[ -n $saved_mtu ]] && MTU=$saved_mtu
  case $TYPE in
    gre|fou)
      local k=$KEY
      if [[ -z $editing ]]; then
        local n; for n in $(tunnel_names); do
          [[ $(tvar "$n" REMOTE_IP) == "$REMOTE_IP" && $(tvar "$n" TYPE) =~ ^(gre|fou)$ ]] && k=$(( RANDOM % 9000 + 1000 ))
        done
      fi
      KEY=$(ask "GRE key (empty = none; needed for a 2nd GRE tunnel to the same server)" "$k") ;;
    vxlan) VNI=$(ask "VXLAN ID" "$VNI") ;;
  esac
  [[ $TYPE =~ ^(vxlan|fou|wg|fec|rathole|backpack|ltcar)$ ]] && PORT=$(ask "UDP/TCP port" "$PORT")
  [[ $TYPE == backpack ]] && CARRIER=$(ask "Carrier: tcp / tcpmux (many short connections) / kcp (UDP+FEC, gaming)" "$CARRIER")
  if [[ $TYPE =~ ^(wg|fec|rathole|backpack|ltcar)$ ]]; then SECRET=$(ask "Shared secret (same on both sides)" "${SECRET:-$(rand_secret)}"); fi
  if is_kernel; then
    echo "${D}Filtered routes (e.g. Iran -> abroad) cut flows the Iran side starts. Answer 'me' on the abroad server"
    echo "and 'peer' on the Iran server: the abroad side then always opens the tunnel. Empty = off.${N}"
    OPENER=$(ask "Who sends first: me / peer / empty" "$OPENER")
    if [[ $TYPE == vxlan && -n $OPENER ]]; then
      echo "${D}Flows: 1 = one UDP flow. 8-16 = spread over that many flows (gets past per-flow speed limits, uses"
      echo "more CPU cores). Uses the ports above the tunnel port; same value on both sides.${N}"
      FLOWS=$(ask "Flows" "$FLOWS")
    fi
  fi
  if [[ $TYPE == fec ]]; then
    RAW=$(ask "Disguise with udp2raw: yes = fake TCP, icmp = looks like ping, no = plain UDP" "$RAW")
    FEC=$(ask "FEC ratio data:redundant" "$FEC")
  fi
  is_l3 && MTU=$(ask "MTU" "$MTU")
  if is_port_tun; then
    FWD_TCP=$(ask "TCP ports to carry (space separated)" "$FWD_TCP")
    FWD_UDP=$(ask "UDP ports to carry (space separated)" "$FWD_UDP")
  else
    echo "${D}Port forwarding: clients connect to this server's ports, traffic goes through the tunnel to the other side.${N}"
    FWD_TCP=$(ask "TCP ports/ranges to forward (e.g. 443 8080:8090, empty = none)" "$FWD_TCP")
    FWD_UDP=$(ask "UDP ports/ranges to forward (e.g. 51820)" "$FWD_UDP")
    if [[ -n $FWD_TCP$FWD_UDP ]]; then BACKUP=$(ask "Backup tunnel for automatic failover (empty = none)" "$BACKUP"); fi
  fi
}

declare -A FLAGS=([name]=NAME [type]=TYPE [local]=LOCAL_IP [remote]=REMOTE_IP [addr]=ADDR [peer]=PEER [mtu]=MTU [ttl]=TTL
  [priority]=PRIORITY [port]=PORT [key]=KEY [vni]=VNI [role]=ROLE [secret]=SECRET [fec]=FEC [fec-timeout]=FEC_TIMEOUT
  [fec-mode]=FEC_MODE [raw]=RAW [tcp]=FWD_TCP [udp]=FWD_UDP [backup]=BACKUP [check]=CHECK [interval]=INTERVAL
  [max-loss]=MAX_LOSS [max-jitter]=MAX_JITTER [opener]=OPENER [carrier]=CARRIER [flows]=FLOWS)

parse_flags() {
  while [[ $# -gt 0 ]]; do
    local k=${1#--} v
    [[ $k == *=* ]] && { v=${k#*=}; k=${k%%=*}; } || { v=$2; shift; }
    [[ -n ${FLAGS[$k]} ]] || die "unknown option --$k"
    printf -v "${FLAGS[$k]}" '%s' "$v"
    shift
  done
}

cmd_add() {
  need_root; reset_tunnel
  if [[ $# -gt 0 ]]; then parse_flags "$@"; else wizard ""; fi
  [[ $TYPE == fec && -z $ADDR && -n $ROLE ]] && die "fec needs --addr (server x.x.x.1/24, client x.x.x.2/24)"
  [[ -z $PEER && -n $ADDR && $TYPE != fec ]] && PEER=$(other_host "$ADDR")
  [[ -f $TDIR/$NAME.conf ]] && die "tunnel '$NAME' already exists (use edit)"
  tunnel_defaults; validate_tunnel
  [[ $TYPE == fec && ! -x $OPT/tinyvpn ]] && install_fec
  [[ $TYPE == rathole && ! -x $OPT/rathole ]] && install_rathole
  [[ $TYPE == backpack && -z $(bp_bin) ]] && install_backpack
  [[ $TYPE == ltcar && ! -x $OPT/ltcar ]] && install_ltcar
  save_tunnel
  start_tunnel
  echo; info "Run this on the other server ($REMOTE_IP):"; echo; peer_cmd; echo
}

cmd_edit() {
  need_root
  local n=${1:-$(pick_tunnel)}; shift
  load_tunnel "$n"
  local old_unit; old_unit=$(unit_of)
  if [[ $# -gt 0 ]]; then parse_flags "$@"; else wizard edit; fi
  NAME=$n; tunnel_defaults; validate_tunnel
  systemctl disable --now "$old_unit" >/dev/null 2>&1   # stops with the old config still on disk
  save_tunnel
  start_tunnel
}

cmd_del() {
  need_root
  local n=${1:-$(pick_tunnel)} a
  load_tunnel "$n"
  if [[ $2 != -y ]]; then read -rp "Delete tunnel $n ($TYPE to $REMOTE_IP)? [y/N]: " a; [[ $a =~ ^[yY] ]] || return; fi
  stop_tunnel
  rm -f "$TDIR/$n.conf" "$STATE/$n".* "$STATE/rathole-$n.toml" "$STATE/backpack-$n.toml"
  ok "deleted $n"
}

peer_cmd() {   # loaded tunnel -> matching add command for the other server
  local prefix=${ADDR#*/} role=""
  [[ $ROLE == server ]] && role=client; [[ $ROLE == client ]] && role=server
  local s="lighttun add --name $NAME --type $TYPE --local $REMOTE_IP --remote $LOCAL_IP --priority $PRIORITY"
  is_l3 && s+=" --addr $PEER/$prefix --peer ${ADDR%/*} --mtu $MTU"
  [[ -n $KEY ]] && s+=" --key $KEY"
  [[ $TYPE == vxlan ]] && s+=" --vni $VNI"
  [[ $TYPE == vxlan ]] && (( FLOWS > 1 )) && s+=" --flows $FLOWS"
  [[ $TYPE =~ ^(vxlan|fou|wg|fec|rathole|backpack|ltcar)$ ]] && s+=" --port $PORT"
  [[ $TYPE == backpack ]] && s+=" --carrier $CARRIER"
  [[ -n $role ]] && s+=" --role $role --secret $SECRET"
  [[ $TYPE == wg ]] && s+=" --secret $SECRET"
  [[ $OPENER == me ]] && s+=" --opener peer"; [[ $OPENER == peer ]] && s+=" --opener me"
  [[ $TYPE == fec ]] && s+=" --raw $RAW --fec $FEC"
  is_port_tun && [[ -n $FWD_TCP ]] && s+=" --tcp '$FWD_TCP'"
  is_port_tun && [[ -n $FWD_UDP ]] && s+=" --udp '$FWD_UDP'"
  echo "  $s"
}

cmd_peer() { local n=${1:-$(pick_tunnel)}; load_tunnel "$n"; peer_cmd; }

cmd_set() {   # lighttun set NAME KEY=VAL ...
  need_root
  local n=$1; shift; load_tunnel "$n"
  local old_unit kv k; old_unit=$(unit_of)
  for kv in "$@"; do
    k=${kv%%=*}; [[ " ${TVARS[*]} " == *" $k "* && $k != NAME ]] || die "unknown setting $k (valid: ${TVARS[*]})"
    printf -v "$k" '%s' "${kv#*=}"
  done
  tunnel_defaults; validate_tunnel
  systemctl disable --now "$old_unit" >/dev/null 2>&1
  save_tunnel; start_tunnel
}

for_tunnels() {   # action name|all
  local act=$1 n names; [[ -z $2 || $2 == all ]] && names=$(tunnel_names) || names=$2
  for n in $names; do
    load_tunnel "$n"
    case $act in
      up|restart) start_tunnel ;;
      down) stop_tunnel; ok "$n stopped" ;;
    esac
  done
}

human() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "$1"; }

cmd_list() {
  local n
  printf "${W}%-12s %-8s %-7s %-16s %-20s %s${N}\n" NAME TYPE PRIO REMOTE "TUNNEL IP -> PEER" FORWARDS
  for n in $(tunnel_names); do
    load_tunnel "$n"
    local fw=""; [[ -n $FWD_TCP ]] && fw+="tcp:$FWD_TCP "; [[ -n $FWD_UDP ]] && fw+="udp:$FWD_UDP"
    printf "%-12s %-8s %-7s %-16s %-20s %s\n" "$NAME" "$TYPE" "$PRIORITY" "$REMOTE_IP" "${ADDR%/*} -> ${PEER:--}" "${fw:--}"
  done
}

cmd_status() {
  local n
  printf "${W}%-12s %-8s %-7s %-9s %-8s %-8s %-6s %-9s %-9s %s${N}\n" NAME TYPE PRIO STATE RTT JITTER LOSS RX TX ROUTE
  for n in $(tunnel_names); do
    load_tunnel "$n"
    local st="-" rtt="-" jit="-" loss="-" rx=0 tx=0 via=""
    systemctl is-active -q "$(unit_of)" || st="stopped"
    if [[ -f $STATE/$n.state ]]; then
      local S_STATUS S_RTT S_JIT S_LOSS S_TS; . "$STATE/$n.state"
      if [[ $st != stopped ]] && (( $(date +%s) - S_TS < INTERVAL * 4 + 30 )); then st=$S_STATUS rtt=$S_RTT jit=$S_JIT loss=$S_LOSS; fi
    fi
    [[ $st == "-" ]] && st=active
    rx=$(cat "/sys/class/net/$n/statistics/rx_bytes" 2>/dev/null); tx=$(cat "/sys/class/net/$n/statistics/tx_bytes" 2>/dev/null)
    [[ -f $STATE/$n.via ]] && via=$(cat "$STATE/$n.via"); [[ $via == "$n" ]] && via=""
    local col=$G; [[ $st == degraded ]] && col=$Y; [[ $st =~ ^(down|stopped)$ ]] && col=$R
    printf "%-12s %-8s %-7s ${col}%-9s${N} %-8s %-8s %-6s %-9s %-9s %s\n" "$n" "$TYPE" "$PRIORITY" "$st" "$rtt" "$jit" "${loss}%" \
      "$(human "$rx")" "$(human "$tx")" "${via:+failover->$via}"
  done
  load_global
  [[ -n $QOS_WAN ]] && echo "${D}QoS: cake on $QOS_WAN at $QOS_BW (gaming tunnels first)${N}" || echo "${D}QoS: off (lighttun qos on)${N}"
}

# ---------------------------------------------------------------- health

ping_stats() {   # ip count interval -> "loss avg mdev"
  local out loss avg mdev
  out=$(ping -n -q -c "$2" -i "$3" -W 1 "$1" 2>/dev/null)
  loss=$(grep -oP '[\d.]+(?=% packet loss)' <<<"$out")
  read -r avg mdev < <(sed -n 's#.*= [0-9.]*/\([0-9.]*\)/[0-9.]*/\([0-9.]*\) ms.*#\1 \2#p' <<<"$out")
  echo "${loss:-100} ${avg:--} ${mdev:--}"
}

check_tunnel() {   # loaded tunnel -> sets H_STATUS H_RTT H_JIT H_LOSS
  H_RTT="-" H_JIT="-" H_LOSS=0
  if is_port_tun; then
    systemctl is-active -q "$(unit_of)" && H_STATUS=up || { H_STATUS=down; H_LOSS=100; }
    return
  fi
  read -r H_LOSS H_RTT H_JIT < <(ping_stats "$PEER" 5 0.2)
  if [[ ${H_LOSS%.*} -ge 100 ]]; then H_STATUS=down
  elif fgt "$H_LOSS" "$MAX_LOSS" || fgt "$H_JIT" "$MAX_JITTER"; then H_STATUS=degraded
  else H_STATUS=up; fi
}

write_state() { printf 'S_STATUS=%s\nS_RTT=%s\nS_JIT=%s\nS_LOSS=%s\nS_TS=%s\n' "$H_STATUS" "$H_RTT" "$H_JIT" "${H_LOSS%.*}" "$(date +%s)" > "$STATE/$NAME.state"; }

notify() {
  echo "$*"
  [[ -n $TG_TOKEN && -n $TG_CHAT ]] || return 0
  local px=(); [[ -n $TG_PROXY ]] && px=(-x "$TG_PROXY")
  curl -s -m 10 "${px[@]}" -d chat_id="$TG_CHAT" --data-urlencode text="LightTun [$NODE_NAME] $*" \
    "https://api.telegram.org/bot$TG_TOKEN/sendMessage" >/dev/null 2>&1 &
}

switch_route() {   # tunnel target
  local old new
  old=$(cat "$STATE/$NAME.via" 2>/dev/null || echo "$NAME")
  fw_forward "$2"
  # drop flows still pinned to the old path so clients reconnect through the new one
  old=$( [[ $old == "$NAME" ]] && echo "$PEER" || tvar "$old" PEER )
  command -v conntrack >/dev/null && conntrack -D --reply-src "$old" >/dev/null 2>&1
}

cmd_monitor() {
  need_root; mkdir -p "$STATE"
  declare -A next fails bad good last_restart last_status
  local n now
  info "LightTun monitor started"
  while true; do
    load_global
    now=$(date +%s)
    for n in $(tunnel_names); do
      (( now < ${next[$n]:-0} )) && continue
      load_tunnel "$n"
      next[$n]=$(( now + INTERVAL ))
      [[ $CHECK == yes ]] || continue
      systemctl is-enabled -q "$(unit_of)" 2>/dev/null || continue
      check_tunnel; write_state
      if [[ $H_STATUS == down ]]; then fails[$n]=$(( ${fails[$n]:-0} + 1 )); else fails[$n]=0; fi
      if [[ $H_STATUS == up ]]; then bad[$n]=0; good[$n]=$(( ${good[$n]:-0} + 1 )); else bad[$n]=$(( ${bad[$n]:-0} + 1 )); good[$n]=0; fi
      if [[ $H_STATUS != "${last_status[$n]:-up}" ]]; then
        notify "$n is $H_STATUS (rtt ${H_RTT}ms jitter ${H_JIT}ms loss ${H_LOSS}%)"
        last_status[$n]=$H_STATUS
      fi
      # restart a dead tunnel, at most once a minute
      if (( ${fails[$n]} >= 3 && now - ${last_restart[$n]:-0} > 60 )); then
        notify "$n down for ${fails[$n]} checks - restarting"
        systemctl restart "$(unit_of)"; last_restart[$n]=$now
      fi
      # failover of forwarded ports to the backup tunnel, and back once healthy again
      if [[ -n $BACKUP && -n $FWD_TCP$FWD_UDP ]]; then
        local via; via=$(cat "$STATE/$n.via" 2>/dev/null || echo "$n")
        local bst; bst=$(. "$STATE/$BACKUP.state" 2>/dev/null; echo "$S_STATUS")
        if [[ $via == "$n" ]] && (( ${bad[$n]} >= 3 )) && [[ $bst == up ]]; then
          switch_route "$n" "$BACKUP"; notify "$n: ports moved to backup $BACKUP"
        elif [[ $via != "$n" ]] && (( ${good[$n]} >= 5 )); then
          switch_route "$n" "$n"; notify "$n: healthy again, ports moved back"
        fi
      fi
    done
    sleep 1
  done
}

cmd_health() {
  local n
  printf "${W}%-12s %-9s %-9s %-9s %s${N}\n" NAME STATE RTT_MS JITTER_MS LOSS
  for n in $(tunnel_names); do
    load_tunnel "$n"; check_tunnel
    printf "%-12s %-9s %-9s %-9s %s%%\n" "$n" "$H_STATUS" "$H_RTT" "$H_JIT" "$H_LOSS"
  done
}

# ---------------------------------------------------------------- QoS (gaming priority)

# no QoS: fq on the WAN, which BBR paces through (cheaper than TCP's own pacing timers). default_qdisc only
# reaches qdiscs created after it is set, so a server tuned without a reboot keeps fq_codel until this runs.
# Only the kernel's default qdiscs are replaced, never one someone chose (cake, htb, ...).
wan_fq() {
  local w q l re='^qdisc (fq_codel|pfifo_fast) [0-9a-f]*: (root|parent ([0-9a-f]*:[0-9a-f]+))'
  w=$(wan_dev); [[ -n $w ]] || return 0
  q=$(tc qdisc show dev "$w")
  grep -qE '^qdisc (fq_codel|pfifo_fast) ' <<<"$q" || return 0
  # multiqueue NIC: the kernel's own mq has no handle to address its children by, so rebuild it with one
  # (its new children take default_qdisc, fq)
  if [[ $q == "qdisc mq 0: root"* ]]; then
    tc qdisc replace dev "$w" root handle 1: mq 2>/dev/null || return 0
    q=$(tc qdisc show dev "$w")
  fi
  while read -r l; do
    [[ $l =~ $re ]] || continue
    if [[ -n ${BASH_REMATCH[3]} ]]; then tc qdisc replace dev "$w" parent "${BASH_REMATCH[3]}" fq
    else tc qdisc replace dev "$w" root fq; fi
  done <<<"$q" 2>/dev/null
  return 0
}

qos_apply() {
  load_global
  [[ -n $QOS_WAN && -n $QOS_BW ]] || { wan_fq; return 0; }
  modprobe sch_cake 2>/dev/null
  if tc qdisc replace dev "$QOS_WAN" root cake bandwidth "$QOS_BW" diffserv4 wash 2>/dev/null; then
    [[ $1 == quiet ]] || ok "cake on $QOS_WAN at $QOS_BW: gaming=Voice tin, normal=Best effort, bulk=Bulk tin"
  else
    warn "cake qdisc not available (try: apt install linux-modules-extra-\$(uname -r)); using fq_codel without priority"
    tc qdisc replace dev "$QOS_WAN" root fq_codel 2>/dev/null
  fi
}

cmd_qos() {
  need_root; load_global
  case $1 in
    on)
      shift
      local wan=${QOS_WAN:-$(wan_dev)} bw=$QOS_BW
      while [[ $# -gt 0 ]]; do case $1 in --wan) wan=$2; shift 2 ;; --bw) bw=$2; shift 2 ;; *) die "unknown option $1" ;; esac; done
      if [[ -z $bw ]]; then
        local sp; sp=$(cat "/sys/class/net/$wan/speed" 2>/dev/null)
        [[ $sp =~ ^[0-9]+$ && $sp -gt 0 && $sp -le 10000 ]] || sp=1000
        echo "Set this a little (~5%) below your real upload speed so the queue stays on this server and gaming can jump it."
        bw=$(ask "Upload bandwidth of $wan" "$(( sp * 95 / 100 ))mbit")
      fi
      QOS_WAN=$wan QOS_BW=$bw; save_global; qos_apply ;;
    off)
      [[ -n $QOS_WAN ]] && tc qdisc del dev "$QOS_WAN" root 2>/dev/null
      QOS_WAN="" QOS_BW=""; save_global; ok "QoS off" ;;
    *)
      [[ -n $QOS_WAN ]] && tc -s qdisc show dev "$QOS_WAN" | head -40 || echo "QoS is off. Enable: lighttun qos on [--wan eth0] [--bw 900mbit]" ;;
  esac
}

cmd_telegram() {
  need_root; load_global
  TG_TOKEN=$(ask "Bot token (empty = disable)" "$TG_TOKEN")
  TG_CHAT=$(ask "Chat ID" "$TG_CHAT")
  TG_PROXY=$(ask "Proxy for Telegram API, e.g. socks5h://127.0.0.1:1080 (needed in Iran)" "$TG_PROXY")
  NODE_NAME=$(ask "Name of this server in alerts" "$NODE_NAME")
  save_global
  notify "test alert - Telegram alerts are working"
  systemctl restart lighttun-monitor 2>/dev/null
  ok "saved"
}

# ---------------------------------------------------------------- install / setup

arch_tag() { case $(uname -m) in x86_64) echo amd64 ;; aarch64) echo arm64 ;; armv7l) echo arm ;; *) uname -m ;; esac; }

install_fec() {
  need_root; mkdir -p "$OPT"
  local tmp a; tmp=$(mktemp -d); a=$(arch_tag)
  info "downloading tinyfecVPN and udp2raw"
  curl -fsSL -o "$tmp/t.tgz" https://github.com/wangyu-/tinyfecVPN/releases/latest/download/tinyvpn_binaries.tar.gz || die "download failed"
  curl -fsSL -o "$tmp/u.tgz" https://github.com/wangyu-/udp2raw/releases/latest/download/udp2raw_binaries.tar.gz || die "download failed"
  tar xzf "$tmp/t.tgz" -C "$tmp" && tar xzf "$tmp/u.tgz" -C "$tmp"
  local tv ur
  tv=$(find "$tmp" -type f -name "tinyvpn_$a" | head -1)
  ur=$(find "$tmp" -type f -name "udp2raw_${a}_hw_aes" | head -1)
  grep -qw aes /proc/cpuinfo && [[ -n $ur ]] || ur=$(find "$tmp" -type f -name "udp2raw_$a" | head -1)
  [[ -n $tv && -n $ur ]] || die "no binaries for $(uname -m) in the release"
  install -m 755 "$tv" "$OPT/tinyvpn"; install -m 755 "$ur" "$OPT/udp2raw"
  rm -rf -- "$tmp"
  ok "installed $OPT/tinyvpn and $OPT/udp2raw"
}

install_rathole() {
  need_root; mkdir -p "$OPT"
  local tmp t; tmp=$(mktemp -d)
  case $(uname -m) in x86_64) t=x86_64-unknown-linux-gnu ;; aarch64) t=aarch64-unknown-linux-musl ;; armv7l) t=armv7-unknown-linux-musleabihf ;; *) die "unsupported arch" ;; esac
  info "downloading rathole"
  curl -fsSL -o "$tmp/r.zip" "https://github.com/rapiz1/rathole/releases/latest/download/rathole-$t.zip" || die "download failed"
  { command -v unzip >/dev/null && unzip -qo "$tmp/r.zip" -d "$tmp" && install -m 755 "$tmp/rathole" "$OPT/rathole"; } ||
    { rm -rf -- "$tmp"; die "could not unpack rathole (is unzip installed?)"; }
  rm -rf -- "$tmp"
  ok "installed $OPT/rathole"
}

install_backpack() {   # github.com/AminMGMT/BackPack (AGPL-3.0), checked against the release's SHA256SUMS
  need_root; mkdir -p "$OPT"
  local tmp a u=https://github.com/AminMGMT/BackPack/releases/latest/download; tmp=$(mktemp -d)
  case $(uname -m) in x86_64) a=amd64 ;; aarch64) a=arm64 ;; armv7l) a=armv7 ;; i?86) a=386 ;; *) die "unsupported arch" ;; esac
  info "downloading BackPack"
  curl -fsSL -o "$tmp/backpack_linux_$a.tar.gz" "$u/backpack_linux_$a.tar.gz" && curl -fsSL -o "$tmp/SHA256SUMS" "$u/SHA256SUMS" \
    || { rm -rf -- "$tmp"; die "download failed"; }
  ( cd "$tmp" && grep " backpack_linux_$a.tar.gz\$" SHA256SUMS | sha256sum -c --quiet ) || { rm -rf -- "$tmp"; die "checksum mismatch"; }
  tar xzf "$tmp/backpack_linux_$a.tar.gz" -C "$tmp" backpack && install -m 755 "$tmp/backpack" "$OPT/backpack"
  rm -rf -- "$tmp"
  ok "installed $OPT/backpack ($("$OPT/backpack" -v 2>/dev/null | head -1))"
}

# ltcar has no release binary: it is built here from proto/ltcar/main.go (installed by install.sh, else fetched
# from the repo) with the server's Go 1.22+, or a temporary Go toolchain that is checked against go.dev's SHA256
# and removed afterwards. Iran servers often can't reach go.dev: build on the abroad server, copy /opt/lighttun/ltcar
# over and run "lighttun install ltcar /path/to/ltcar".
GO_VER=1.23.4
install_ltcar() {   # [prebuilt binary]
  need_root; mkdir -p "$OPT"
  if [[ -n $1 ]]; then
    [[ -f $1 ]] || die "no file $1"
    install -m 755 "$1" "$OPT/.ltcar.new"   # a copied file usually lost its exec bit
    [[ $("$OPT/.ltcar.new" 2>&1) == *"usage: ltcar"* ]] || { rm -f "$OPT/.ltcar.new"; die "$1 is not an ltcar binary"; }   # exits 1 after usage
    mv -f "$OPT/.ltcar.new" "$OPT/ltcar"; ok "installed $OPT/ltcar"; return
  fi
  local tmp a go src u sum; tmp=$(mktemp -d)
  case $(uname -m) in x86_64) a=amd64 ;; aarch64) a=arm64 ;; armv7l) a=armv6l ;; *) rm -rf -- "$tmp"; die "unsupported arch" ;; esac
  mkdir -p "$tmp/b"
  src=$OPT/src/ltcar/main.go
  if [[ -f $src ]]; then cp "$src" "$tmp/b/main.go"
  else
    info "downloading the ltcar source"
    curl -fsSL -o "$tmp/b/main.go" "https://raw.githubusercontent.com/$REPO/main/proto/ltcar/main.go" \
      || { rm -rf -- "$tmp"; die "could not download the ltcar source"; }
  fi
  printf 'module ltcar\n\ngo 1.22\n' > "$tmp/b/go.mod"
  go=$(command -v go || { [[ -x /usr/local/go/bin/go ]] && echo /usr/local/go/bin/go; })
  if [[ -n $go ]] && ! "$go" version | grep -qE 'go1\.(2[2-9]|[3-9][0-9])'; then go=""; fi
  if [[ -z $go ]]; then
    for u in https://go.dev/dl https://golang.google.cn/dl; do
      info "downloading Go $GO_VER from ${u%/dl} (removed after the build)"
      curl -fsSL -m 300 -o "$tmp/go.tgz" "$u/go$GO_VER.linux-$a.tar.gz" || continue
      sum=$(curl -fsSL -m 30 "$u/?mode=json&include=all" | python3 -c 'import json,sys
f=sys.argv[1]
print(next((x["sha256"] for r in json.load(sys.stdin) for x in r["files"] if x["filename"]==f), ""))' "go$GO_VER.linux-$a.tar.gz")
      [[ -n $sum ]] && echo "$sum  $tmp/go.tgz" | sha256sum -c --quiet 2>/dev/null && break
      warn "checksum check failed for the Go download from $u"; rm -f "$tmp/go.tgz"
    done
    [[ -f $tmp/go.tgz ]] || { rm -rf -- "$tmp"; die "could not get Go. Build ltcar on a server that can (lighttun install ltcar), copy $OPT/ltcar here and run: lighttun install ltcar /path/to/ltcar"; }
    tar xzf "$tmp/go.tgz" -C "$tmp" && go=$tmp/go/bin/go
  fi
  info "building ltcar"
  ( cd "$tmp/b" && CGO_ENABLED=0 GOTOOLCHAIN=local GOCACHE=$tmp/cache GOPATH=$tmp/gopath GOFLAGS=-modcacherw \
      "$go" build -trimpath -ldflags='-s -w' -o "$tmp/ltcar" . ) || { rm -rf -- "$tmp"; die "ltcar build failed"; }
  install -m 755 "$tmp/ltcar" "$OPT/ltcar"
  rm -rf -- "$tmp"
  ok "installed $OPT/ltcar (sha256 $(sha256sum "$OPT/ltcar" | cut -c1-16)...)"
}

